{
  "name": "@svebcomponents/ssr-vue",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svebcomponents/svebcomponents.git",
    "directory": "packages/ssr-vue"
  },
  "type": "module",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc && publint",
    "check": "tsc --noEmit",
    "lint": "pnpm /^lint:.*/",
    "lint:eslint": "eslint .",
    "lint:format": "prettier --check .",
    "fix": "pnpm /^fix:.*/",
    "fix:eslint": "eslint . --fix",
    "fix:format": "prettier --write --ignore-unknown .",
    "test": "vitest run",
    "test:dev": "vitest --watch"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/vitePluginSvebcomponentsSsrVue.d.ts",
      "import": "./dist/vite/vitePluginSvebcomponentsSsrVue.js"
    }
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@svebcomponents/eslint-config": "workspace:*",
    "@svebcomponents/prettier-config": "workspace:*",
    "@svebcomponents/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "dependencies": {
    "@svebcomponents/ssr": "workspace:*",
    "@svebcomponents/utils": "workspace:*",
    "@vue/compiler-dom": "catalog:",
    "esm-env": "catalog:",
    "magic-string": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "vue",
    "svelte",
    "web-components",
    "ssr"
  ]
}
