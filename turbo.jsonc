{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "fix": {},
    "check": {
      // `build`, not `^build`: a package may type-check against its own
      // generated output. `e2e/basic` checks its component-type test against
      // the declarations `svebcomponents` emits into `dist/client`, which only
      // its own build produces — and CI runs `check` before `build`. `build`
      // already depends on `^build`, so upstream packages are still covered.
      "dependsOn": [
        "build"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "build"
      ]
    },
    "test:dev": {
      "cache": false,
      "persistent": true
    }
  }
}
