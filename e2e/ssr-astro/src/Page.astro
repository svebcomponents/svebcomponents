---
const { title } = Astro.props;
---

<div id="app">
  {/* meta is a rich prop with no attribute representation: it must reach the
      element through the serialized-props channel */}
  <sync-component
    title={title}
    count="3"
    enabled=""
    meta={{ note: "rich prop survived" }}
  >
    <p id="light-dom">light dom child</p>
  </sync-component>
</div>
