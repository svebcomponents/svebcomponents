    "@svebcomponents/vitest-config": "workspace:*",
    "@lit-labs/ssr": "catalog:",
    "@vitest/browser": "catalog:",
    "vitest": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
