{
  "name": "@svebcomponents/e2e.ssr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "svebcomponents",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
